APP_NAME="LeadoChat Mini"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

SECURITY_HEADERS_ENABLED=true
CSP_REPORT_ONLY_ENABLED=true
CSP_REPORT_MAX_BYTES=65536
CSP_REPORT_MAX_BATCH=20
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=86400

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=leadochat_mini
DB_USERNAME=leadochat
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
ATTACHMENT_PROVIDER_URL_TTL_MINUTES=60
QUEUE_CONNECTION=database

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AUTH_EMAIL_VERIFICATION_EXPIRE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_COMMERCE_REVIEW_SCOPES=
INSTAGRAM_WEBHOOK_APP_ID=
INSTAGRAM_WEBHOOK_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost/connect/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish,instagram_business_manage_insights
INSTAGRAM_WEBHOOK_SUBSCRIBED_FIELDS=messages,comments,standby,messaging_postbacks,message_reactions,messaging_seen,messaging_referral,messaging_handover,message_edit
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
